diff --git a/css/style.css b/css/style.css
index c47d7f4..3fd2dc1 100644
--- a/css/style.css
+++ b/css/style.css
@@ -1020,3 +1020,79 @@ button {
 @media (max-width: 620px) {
   .connection-summary .measures { grid-template-columns: 1fr; }
 }
+
+/* Vibe gallery: descriptive, ordinal observations rather than a diagnosis. */
+.vibe-hero {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(8rem, 15rem);
+  align-items: center;
+  gap: 1.2rem;
+}
+.vibe-hero img { width: 100%; height: auto; filter: drop-shadow(0 12px 20px rgba(0, 0, 0, .08)); }
+.vibe-gallery {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 1rem;
+  margin-top: 1.25rem;
+}
+.vibe-panel {
+  min-width: 0;
+  padding: 1.2rem;
+  border: 1px solid var(--rule);
+  border-radius: 1rem;
+  background: var(--paper-raised);
+}
+.vibe-panel h3 { margin: 0; font: 700 clamp(1.25rem, 3vw, 1.65rem)/1.15 var(--font-display); }
+.vibe-panel p { color: var(--ink-soft); font-size: .9rem; }
+.vibe-map {
+  position: relative;
+  height: clamp(12rem, 24vw, 18rem);
+  margin: 2.1rem 2.6rem 2.5rem;
+  border: 2px solid var(--ink);
+  border-radius: .4rem;
+  background:
+    linear-gradient(90deg, transparent calc(50% - 1px), var(--rule) 50%, transparent calc(50% + 1px)),
+    linear-gradient(0deg, transparent calc(50% - 1px), var(--rule) 50%, transparent calc(50% + 1px)),
+    linear-gradient(135deg, #e7d7fa 0%, #f8e3c7 48%, #d7f4dc 100%);
+}
+.map-dot {
+  position: absolute;
+  z-index: 1;
+  width: 1.65rem;
+  height: 1.65rem;
+  border: 3px solid white;
+  border-radius: 50%;
+  background: var(--ink);
+  box-shadow: 0 0 0 2px var(--ink);
+  transform: translate(-50%, 50%);
+}
+.axis-label { position: absolute; font: 600 .72rem/1.25 var(--font-mono); white-space: nowrap; }
+.axis-label.top { top: -1.7rem; left: 0; }
+.axis-label.bottom { bottom: -1.7rem; left: 0; }
+.axis-label.left { bottom: -2.5rem; left: 0; }
+.axis-label.right { bottom: -2.5rem; right: 0; }
+.balance-bars { display: grid; gap: 1rem; margin-top: 1.5rem; }
+.balance-row-head { display: flex; gap: .6rem; justify-content: space-between; font-size: .88rem; }
+.chart-n { margin-bottom: 0; font: .75rem var(--font-mono); }
+.balance-row-head strong { min-width: 0; overflow-wrap: anywhere; }
+.balance-row-head span { flex: none; font: .8rem var(--font-mono); }
+.balance-track { height: 1.3rem; margin-top: .4rem; border-radius: 1rem; background: var(--rule-soft); overflow: hidden; }
+.balance-track span { display: block; height: 100%; border-radius: inherit; background: #a2dfb6; }
+.balance-row:nth-child(2) .balance-track span { background: #bdb0e9; }
+.idea-panel { grid-column: 1 / -1; background: linear-gradient(115deg, #e7f5e7, #f4ecfa); }
+.idea-panel p { max-width: 50rem; font-size: 1.05rem; color: var(--ink); }
+.method-note { margin-top: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--rule); border-radius: .75rem; }
+.method-note summary { cursor: pointer; font-weight: 700; }
+.method-note p { font-size: .86rem; }
+.method-note a { color: var(--accent); overflow-wrap: anywhere; }
+@media (max-width: 690px) {
+  .vibe-gallery { grid-template-columns: 1fr; }
+  .vibe-hero { grid-template-columns: minmax(0, 1fr) minmax(5rem, 8rem); }
+  .axis-label { font-size: .65rem; }
+}
+@media (max-width: 390px) {
+  .vibe-hero { grid-template-columns: 1fr; }
+  .vibe-hero img { width: 8rem; }
+  .vibe-map { margin-inline: 1.9rem; }
+  .axis-label { white-space: normal; max-width: 50%; }
+}
