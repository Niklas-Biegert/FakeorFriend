+
+/* FakeorFriend: a direct three-stage flow with readable dark surfaces. */
+body { overflow-x: clip; }
+main, .masthead, .colophon { width: min(1100px, calc(100% - 2rem)); }
+.masthead { align-items: center; border-bottom: 1px solid var(--rule); }
+.masthead strong { font: 800 1.2rem var(--font-display); color: var(--accent); }
+.masthead span:nth-child(3) { display: none; }
+.masthead select { padding: .55rem .7rem; border-radius: .7rem; }
+.hero { grid-template-columns: minmax(0, 1.3fr) minmax(15rem, .7fr); gap: 1.5rem; padding: clamp(3rem, 7vw, 6rem) 0 2rem; align-items: center; }
+h1 { font: 800 clamp(3.4rem, 8vw, 6.6rem)/.98 var(--font-display); letter-spacing: -.06em; overflow-wrap: anywhere; }
+h1 em { color: var(--accent); font-style: normal; }
+.hero-aside { display: grid; justify-items: center; gap: 1.25rem; min-width: 0; }
+.lede { padding: 0; border: 0; font-size: clamp(1rem, 1.8vw, 1.2rem); color: var(--ink-soft); }
+.hero-art { position: relative; isolation: isolate; width: min(100%, 16rem); aspect-ratio: 1.8; transform: rotate(-5deg); }
+.hero-art span { position: absolute; display: grid; place-items: center; font: 800 3rem var(--font-display); color: var(--paper); box-shadow: 0 12px 35px #140a18a0; }
+.hero-art .bubble-one { left: 4%; top: 5%; width: 57%; height: 63%; border-radius: 1.5rem 1.5rem 1.5rem .3rem; background: var(--accent-blue); }
+.hero-art .bubble-two { right: 4%; bottom: 2%; width: 55%; height: 63%; border-radius: 1.5rem 1.5rem .3rem 1.5rem; background: var(--accent); transform: rotate(11deg); }
+.hero-art .art-orbit { display: none; }
+.step-label { display: block; margin: 0 0 .65rem; color: var(--accent); font: 700 .78rem var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
+.intake { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin: 1.5rem 0 0; padding: clamp(1.1rem, 4vw, 2rem); border: 1px solid var(--rule); border-radius: 1.6rem; background: var(--paper-raised); box-shadow: 0 24px 70px #160b1955; }
+.intake-label { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; }
+.intake-label .step-label { flex-basis: 100%; }
+.intake-label b { font: 800 1.8rem var(--font-display); letter-spacing: -.03em; }
+textarea, input, .masthead select { border: 1px solid var(--rule); border-radius: .8rem; }
+textarea { min-height: 13rem; font: .9rem/1.6 var(--font-mono); }
+.chip { border: 1px solid var(--rule); background: #473046; color: var(--ink); }
+.primary, .secondary, .names-form button, .key-form button { min-height: 2.9rem; border-radius: .8rem; }
+.primary { border-color: var(--accent); background: var(--accent); color: #211622; font-weight: 800; }
+.primary:hover:not(:disabled) { background: #f6ffa4; border-color: #f6ffa4; }
+.primary:disabled { opacity: .55; }
+.secondary { border-color: var(--rule); background: var(--accent-blue); color: #211622; font-weight: 700; }
+.secondary:hover { color: #211622; background: #eff9ff; }
+.link { color: var(--accent-blue); text-decoration-color: var(--accent-blue); }
+.link:hover { color: var(--accent); }
+.intake-bar { gap: .75rem; }
+.intake-bar .primary { margin-left: auto; }
+.data-notice { border-left: 3px solid var(--accent-blue); border-radius: .5rem; background: #2a1b2b; }
+.error { color: var(--accent-coral); }
+.results { margin-top: 3rem; }
+.results > .step-label { margin-bottom: 1rem; }
+.connection-summary { border: 1px solid var(--rule); border-radius: 1.6rem; background: linear-gradient(125deg, #433047, #302238 62%, #263241); box-shadow: 0 24px 70px #160b1944; }
+.connection-summary h2 { font: 800 clamp(2rem, 5vw, 3.8rem)/1.08 var(--font-display); letter-spacing: -.04em; }
+.connection-summary .measures { margin-bottom: 0; }
+.scale { min-width: 0; padding: 1rem; border: 1px solid var(--rule); border-radius: 1rem; background: #2d2032; }
+.scale-top { gap: .5rem; font-weight: 700; }
+.scale .track { height: 1rem; border-radius: 999px; overflow: hidden; background: repeating-linear-gradient(90deg, transparent 0 calc(25% - 2px), #2d2032 calc(25% - 2px) 25%), var(--rule-soft); }
+.scale .fill { border-radius: inherit; background: var(--accent); }
+.scale:nth-child(even) .fill { background: var(--accent-blue); }
+.scale-level { margin-top: .55rem; font-weight: 700; color: var(--ink); }
+.scale-explainer { margin: .3rem 0 0; font-size: .85rem; color: var(--ink-soft); }
+.vibe-panel, .plate, .method-note, .card-dialog { border: 1px solid var(--rule); border-radius: 1.2rem; background: var(--paper-raised); }
+.vibe-panel h3 { font-family: var(--font-display); }
+.vibe-map { background: linear-gradient(90deg, transparent calc(50% - 1px), #52445a 50%, transparent calc(50% + 1px)), linear-gradient(0deg, transparent calc(50% - 1px), #52445a 50%, transparent calc(50% + 1px)), linear-gradient(135deg, #655270, #5a465c 48%, #476879); border: 1px solid var(--rule); border-radius: 1rem; }
+.map-dot { border-color: var(--paper); background: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
+.balance-track { background: var(--rule-soft); }
+.balance-track span { background: var(--accent); }
+.balance-row:nth-child(2) .balance-track span { background: var(--accent-blue); }
+.idea-panel { background: linear-gradient(110deg, #354356, #413048); }
+.idea-panel p { color: var(--ink); }
+.plates { gap: 1rem; border: 0; }
+.plate { padding: 1.3rem; }
+.record { padding-left: 1rem; }
+.results-foot { align-items: end; padding-block: 1rem; }
+.share-action { display: grid; gap: .2rem; }
+.share-action .step-label { margin: 0; }
+.card-dialog canvas { border-radius: .8rem; border-color: var(--rule); }
+.card-dialog::backdrop { background: #110a15d9; }
+.card-dialog .primary { width: 100%; }
+.colophon { border-color: var(--rule); }
+textarea:focus-visible, input:focus-visible, button:focus-visible, .track:focus-visible, select:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+@media (max-width: 820px) { .hero { grid-template-columns: 1fr; } .hero-aside { grid-template-columns: minmax(0, 1fr) 11rem; } }
+@media (max-width: 540px) {
+  main, .masthead, .colophon { width: min(100% - 1.25rem, 1100px); }
+  .hero { padding: 2.5rem .35rem 1rem; }
+  h1 { font-size: clamp(2.75rem, 11vw, 4rem); }
+  .hero-aside { grid-template-columns: minmax(0, 1fr) 6rem; }
+  .hero-art { align-self: start; margin-top: 1rem; }
+  .hero-art span { font-size: 1.35rem; border-radius: .8rem !important; }
+  .intake { margin-top: 1rem; padding: 1rem; }
+  .intake-bar .primary { flex-basis: 100%; order: 1; margin: 0; }
+  .intake-bar .secondary { flex: 1; justify-content: center; }
+  .intake-bar .link { flex: 1; }
+  .names-form, .key-form { grid-template-columns: 1fr; }
+  .vibe-hero { grid-template-columns: minmax(0, 1fr) 6rem; }
+  .vibe-hero img { width: 6rem; }
+  .connection-summary { padding: 1.1rem; }
+  .connection-summary .measures { grid-template-columns: 1fr; }
+  .vibe-map { margin: 2.1rem 2rem 2.5rem; }
+  .results-foot { align-items: stretch; }
+  .share-action { width: 100%; }
+  .share-action button { width: 100%; }
+  .card-dialog { width: calc(100% - 1rem); padding: 1rem; }
+}
+@media (max-width: 360px) { .hero-aside { grid-template-columns: 1fr; } .hero-art { display: none; } .counted { grid-template-columns: 1fr; } }
