+    "empty": { "unavailable": "Ce format ne fournit pas de calendrier quotidien vérifiable.", "missingDates": "Des dates manquent ou sont ambiguës. Aucune courbe trompeuse n'est affichée.", "tooLong": "Le chat couvre plus de cinq ans : trop long pour une courbe lisible ici." },
+    "noPatterns": "Pas de motif clair : les observations sont trop rares ou trop ambiguës pour comparer.",
