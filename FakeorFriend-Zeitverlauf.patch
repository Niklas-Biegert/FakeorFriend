diff --git a/js/timeline-view.js b/js/timeline-view.js
new file mode 100644
index 0000000..e964038
--- /dev/null
+++ b/js/timeline-view.js
@@ -0,0 +1,99 @@
+import { t } from './i18n.js';
+
+const ns = 'http://www.w3.org/2000/svg';
+const svgEl = (tag, attributes = {}) => {
+  const element = document.createElementNS(ns, tag);
+  for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, String(value));
+  return element;
+};
+const make = (tag, className, content) => {
+  const node = document.createElement(tag);
+  node.className = className;
+  if (content !== undefined) node.textContent = content;
+  return node;
+};
+const labelDate = (at) => new Date(at).toISOString().slice(0, 10);
+const COLORS = ['#e9f056', '#d7efff'];
+const text = (x, y, value, extra = {}) => {
+  const node = svgEl('text', { x, y, fill: '#e6d6e0', 'font-size': 12, ...extra });
+  node.textContent = String(value);
+  return node;
+};
+
+export function renderTimeline(root, timeline, shownNames) {
+  root.replaceChildren();
+  if (!timeline?.points) {
+    root.append(make('p', 'timeline-empty', t(`timeline.empty.${timeline?.reason ?? 'unavailable'}`)));
+    return;
+  }
+  const { points, trend, weekly, finds } = timeline;
+  const legend = make('div', 'timeline-legend');
+  timeline.people.forEach((name, i) => {
+    const line = make('span', `timeline-key key-${i}`);
+    line.append(make('span', 'key-symbol'), make('strong', '', shownNames?.[i] ?? name));
+    legend.append(line);
+  });
+  root.append(make('p', 'timeline-scope', t('timeline.scope', { n: timeline.activeDays, total: timeline.totalDays })), legend);
+  const chart = svgEl('svg', { viewBox: '0 0 700 300', role: 'img', 'aria-label': t('timeline.accessible', {
+    first: labelDate(points[0].at), last: labelDate(points.at(-1).at),
+    firstName: shownNames?.[0] ?? timeline.people[0], secondName: shownNames?.[1] ?? timeline.people[1],
+  }) });
+  const x = (i) => 54 + i * 620 / Math.max(1, points.length - 1);
+  const max = Math.max(1, ...points.flatMap(({ counts }) => counts), ...(trend ? [trend.start, trend.end] : []));
+  const ceiling = Math.ceil(max);
+  const y = (value) => 244 - Math.max(0, value) / ceiling * 200;
+  for (const tick of [0, 0.5, 1]) {
+    const height = y(ceiling * tick);
+    chart.append(svgEl('line', { x1: 54, x2: 674, y1: height, y2: height, stroke: '#78586d' }),
+      text(46, height + 4, Math.round(ceiling * tick), { 'text-anchor': 'end' }));
+  }
+  for (const i of [...new Set([0, Math.floor((points.length - 1) / 2), points.length - 1])])
+    chart.append(text(x(i), 277, labelDate(points[i].at), { 'text-anchor': i === 0 ? 'start' : i === points.length - 1 ? 'end' : 'middle' }));
+  for (const p of [0, 1]) {
+    const coords = points.map((row, i) => `${x(i)},${y(row.counts[p])}`).join(' ');
+    chart.append(svgEl('polyline', { points: coords, fill: 'none', stroke: COLORS[p], 'stroke-width': p ? 3 : 4,
+      'stroke-dasharray': p ? '8 5' : 'none', 'stroke-linejoin': 'round' }));
+    if (points.length <= 42) points.forEach((row, i) => chart.append(p
+      ? svgEl('rect', { x: x(i) - 3.5, y: y(row.counts[p]) - 3.5, width: 7, height: 7, fill: COLORS[p] })
+      : svgEl('circle', { cx: x(i), cy: y(row.counts[p]), r: 3.6, fill: COLORS[p] })));
+  }
+  if (trend) chart.append(svgEl('line', { x1: x(0), y1: y(trend.start), x2: x(trend.periods - 1), y2: y(trend.end),
+    stroke: '#ffb9a3', 'stroke-width': 2, 'stroke-dasharray': '3 7' }));
+  root.append(chart, make('p', 'timeline-caption', t(weekly ? 'timeline.weekly' : 'timeline.daily')));
+  root.append(make('p', 'timeline-caption', t(trend ? 'timeline.trend' : 'timeline.noTrend')));
+  const details = make('details', 'timeline-table');
+  details.append(make('summary', '', t('timeline.tableTitle')));
+  const table = make('table', '');
+  const head = document.createElement('thead');
+  const trHead = document.createElement('tr');
+  for (const value of [t('timeline.period'), ...(shownNames ?? timeline.people)]) trHead.append(make('th', '', value));
+  head.append(trHead); table.append(head);
+  const body = document.createElement('tbody');
+  for (const row of points) {
+    const tr = document.createElement('tr');
+    for (const value of [labelDate(row.at), ...row.counts]) tr.append(make('td', '', value));
+    body.append(tr);
+  }
+  table.append(body); details.append(table); root.append(details);
+  const cards = make('div', 'pattern-cards');
+  if (!finds.length) cards.append(make('p', 'timeline-empty', t('timeline.noPatterns')));
+  for (const find of finds.slice(0, 2)) {
+    const item = make('article', 'pattern-card');
+    item.append(make('h4', '', t(`timeline.pattern.${find.key}.${find.direction}`)));
+    item.append(make('p', '', t(`timeline.pattern.${find.key}.detail`, find)));
+    const bar = make('div', 'pattern-mini');
+    if (find.key === 'length') {
+      for (const v of [find.low, find.high]) {
+        const col = make('span', 'pattern-bar');
+        col.style.height = `${Math.max(8, v / Math.max(find.low, find.high) * 100)}%`;
+        bar.append(col);
+      }
+    } else {
+      const col = make('span', 'pattern-gauge');
+      col.style.width = `${Math.round(Math.abs(find.rho) * 100)}%`;
+      bar.append(col);
+    }
+    item.append(bar); cards.append(item);
+  }
+  root.append(cards);
+}
diff --git a/js/timeline.js b/js/timeline.js
new file mode 100644
index 0000000..0bcf964
--- /dev/null
+++ b/js/timeline.js
@@ -0,0 +1,87 @@
+const DAY = 86_400_000;
+const MAX_DAYS = 1827;
+const safeDate = (at) => typeof at === 'number' && Number.isSafeInteger(at) && Number.isFinite(new Date(at).getTime());
+const dayOf = (at) => Math.floor(at / DAY) * DAY;
+const median = (values) => {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted.length % 2 ? sorted[(sorted.length - 1) / 2] : (sorted[sorted.length / 2 - 1] + sorted[sorted.length / 2]) / 2;
+};
+const ranks = (values) => {
+  const sorted = values.map((value, i) => [value, i]).sort((a, b) => a[0] - b[0]);
+  const output = Array(values.length);
+  for (let i = 0; i < sorted.length;) {
+    let j = i + 1;
+    while (j < sorted.length && sorted[j][0] === sorted[i][0]) j++;
+    for (let k = i; k < j; k++) output[sorted[k][1]] = (i + j - 1) / 2;
+    i = j;
+  }
+  return output;
+};
+function spearman(x, y) {
+  const a = ranks(x), b = ranks(y);
+  const av = a.reduce((sum, value) => sum + value, 0) / a.length;
+  const bv = b.reduce((sum, value) => sum + value, 0) / b.length;
+  const numerator = a.reduce((sum, value, i) => sum + (value - av) * (b[i] - bv), 0);
+  const aa = a.reduce((sum, value) => sum + (value - av) ** 2, 0);
+  const bb = b.reduce((sum, value) => sum + (value - bv) ** 2, 0);
+  return aa && bb ? numerator / Math.sqrt(aa * bb) : null;
+}
+
+// OLS line through equally spaced calendar periods, including zero periods.
+function trendOf(points) {
+  if (points.filter((point) => point.total > 0).length < 7 || points.length < 14) return null;
+  const mean = points.reduce((sum, item) => sum + item.total, 0) / points.length;
+  const center = (points.length - 1) / 2;
+  const denominator = points.reduce((sum, _, i) => sum + (i - center) ** 2, 0);
+  const slope = points.reduce((sum, item, i) => sum + (i - center) * (item.total - mean), 0) / denominator;
+  return { start: mean - slope * center, end: mean + slope * center, slope, periods: points.length };
+}
+
+/** No time zone conversion: UTC fields reflect the wall-clock fields kept by stamps.js. */
+export function timelineOf(messages, people) {
+  if (!Array.isArray(messages) || people?.length !== 2 || !messages.length ||
+      messages.some(({ author }) => !people.includes(author))) return { reason: 'unavailable' };
+  const valid = messages.filter(({ at }) => safeDate(at));
+  if (valid.length !== messages.length) return { reason: 'missingDates' };
+  const first = valid.reduce((min, { at }) => Math.min(min, dayOf(at)), Infinity);
+  const last = valid.reduce((max, { at }) => Math.max(max, dayOf(at)), -Infinity);
+  const days = Math.round((last - first) / DAY) + 1;
+  if (days > MAX_DAYS) return { reason: 'tooLong' };
+  const byDay = new Map();
+  for (let at = first; at <= last; at += DAY) byDay.set(at, { at, counts: [0, 0], lengths: [[], []] });
+  for (const { author, text, at } of valid) {
+    const row = byDay.get(dayOf(at));
+    const person = people.indexOf(author);
+    row.counts[person]++;
+    row.lengths[person].push(Array.from(text).length);
+  }
+  const daily = [...byDay.values()].map((row) => ({ ...row, total: row.counts[0] + row.counts[1] }));
+  const weekly = days > 42;
+  const points = weekly ? Array.from({ length: Math.ceil(days / 7) }, (_, i) => {
+    const rows = daily.slice(i * 7, i * 7 + 7);
+    return { at: rows[0].at, counts: [0, 1].map((p) => rows.reduce((sum, row) => sum + row.counts[p], 0)),
+      total: rows.reduce((sum, row) => sum + row.total, 0), days: rows.length };
+  }) : daily.map(({ at, counts, total }) => ({ at, counts, total, days: 1 }));
+  const finds = [];
+  const active = daily.filter((row) => row.total > 0);
+  if (active.length >= 10 && [0, 1].every((i) => active.filter((row) => row.counts[i] > 0).length >= 5)) {
+    const rho = spearman(active.map((row) => row.counts[0]), active.map((row) => row.counts[1]));
+    if (rho !== null && Math.abs(rho) >= 0.65) finds.push({ key: 'together', direction: rho > 0 ? 'same' : 'opposite', rho: Math.round(rho * 100) / 100, n: active.length });
+  }
+  // Equal weight per person avoids a change in writer mix looking like a
+  // change in text length. Each participant must supply two messages that day.
+  const lengths = active.filter((row) => row.counts.every((count) => count >= 2))
+    .map((row) => ({ total: row.total, chars: (median(row.lengths[0]) + median(row.lengths[1])) / 2 }))
+    .sort((a, b) => a.total - b.total);
+  if (lengths.length >= 16 && lengths[3].total < lengths.at(-4).total) {
+    const low = median(lengths.slice(0, 4).map((row) => row.chars));
+    const high = median(lengths.slice(-4).map((row) => row.chars));
+    if (Math.abs(high - low) >= 8 && Math.max(high, low) / Math.max(1, Math.min(high, low)) >= 1.3) {
+      finds.push({ key: 'length', direction: high > low ? 'longer' : 'shorter', low, high, n: lengths.length, perGroup: 4 });
+    }
+  }
+  return { people: [...people], daily, points, weekly,
+    trend: trendOf(weekly && points.at(-1).days < 7 ? points.slice(0, -1) : points), finds,
+    activeDays: active.length, totalDays: days,
+    cardFact: days >= 7 && active.length >= 3 ? { activeDays: active.length, totalDays: days } : null };
+}
